+/* c6420: a PEBS auto-reload counter can overflow without writing a record
+ * (likely when a PMI freezes the PMU and acks the overflow first); it then
+ * counts up from 0 and never samples again, while perf still shows it active.
+ * perf_event_period() stops and restarts the event with a reload, re-arming it. */
+#define HTMM_REARM_MS 1000
+static void pebs_rearm(void)
+{
+    int cpu, event;
+
+    for_each_online_cpu (cpu)
+	for (event = 0; event < N_HTMMEVENTS; event++)
+	    if (mem_event[cpu][event])
+		perf_event_period(mem_event[cpu][event],
+				  mem_event[cpu][event]->attr.sample_period);
+}
