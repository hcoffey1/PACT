--- a/mm/htmm_sampler.c
+++ b/mm/htmm_sampler.c
@@ -16,6 +16,40 @@
 struct task_struct *access_sampling = NULL;
 struct perf_event ***mem_event;
 
+/* Diagnostic trace (memtis-sampler-trace.patch): per-CPU, per-event PEBS
+ * state every HTMM_DBG_MS, to find which events stop delivering samples. */
+#define HTMM_DBG_MS 2000
+#define HTMM_DBG_MAX_ANOMALIES 50
+static unsigned long *htmm_dbg_read; /* [cpu * N_HTMMEVENTS + event] */
+static unsigned long htmm_dbg_anomalies;
+
+static void htmm_dbg_dump(void)
+{
+    int cpu, event;
+
+    for_each_online_cpu (cpu) {
+	for (event = 0; event < N_HTMMEVENTS; event++) {
+	    struct perf_event *e = mem_event[cpu][event];
+	    struct perf_buffer *rb;
+
+	    if (!e)
+		continue;
+	    rb = e->rb;
+	    if (!rb) {
+		trace_printk("htmm_dbg cpu=%d ev=%d state=%d rb=NULL\n", cpu, event, e->state);
+		continue;
+	    }
+	    trace_printk("htmm_dbg cpu=%d ev=%d state=%d count=%llu intr=%llu head=%llu tail=%llu "
+			 "size=%lu lost=%ld period=%llu read=%lu idx=%d enabled=%llu running=%llu\n",
+			 cpu, event, e->state, (u64)local64_read(&e->count), (u64)e->hw.interrupts,
+			 (u64)READ_ONCE(rb->user_page->data_head), (u64)READ_ONCE(rb->user_page->data_tail),
+			 perf_data_size(rb), local_read(&rb->lost), (u64)e->hw.sample_period,
+			 htmm_dbg_read ? htmm_dbg_read[cpu * N_HTMMEVENTS + event] : 0,
+			 e->hw.idx, e->total_time_enabled, e->total_time_running);
+	}
+    }
+}
+
 static bool valid_va(unsigned long addr)
 {
     if (!(addr >> (PGDIR_SHIFT + 9)) && addr != 0)
@@ -104,6 +138,9 @@
     for_each_online_cpu (cpu) {
 	mem_event[cpu] = kzalloc(sizeof(struct perf_event *) * N_HTMMEVENTS, GFP_KERNEL);
     }
+    kfree(htmm_dbg_read);
+    htmm_dbg_read = kcalloc(nr_cpu_ids * N_HTMMEVENTS, sizeof(*htmm_dbg_read), GFP_KERNEL);
+    htmm_dbg_anomalies = 0;
     
     printk("pebs_init\n");
 
